---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const url = (p) =>
`${base}${p}`.replace(/\/{2,}/g,'/');

const minis = await getCollection('minis');

const miniaturas = minis
.filter(
  m => m.data.destaque === true
)
.map(m=>({
  slug:m.id,
  href:url(`/minis/${m.id}/`),
  titulo:m.data.titulo,
  imagem:m.data.imagem,
  classes:m.data.classes || [],
  racas:m.data.racas || [],
  sexo:m.data.sexo || [],
  cenarios:m.data.cenarios || [],
  culturaPop:m.data.culturaPop === true
}));

const asset = (p) =>
/^https?:\/\//.test(p) ? p : url(p);

/* Topo: total arredondado ("550+") e as 3 miniaturas em destaque mais recentes. */
const totalTexto = `${Math.floor(minis.length / 10) * 10}+`;

const vitrine = [...miniaturas]
.sort((a,b) => b.slug.localeCompare(a.slug))
.slice(0,3);
---

<Layout titulo="Klipel Studio — Miniaturas para Aventureiros">

<section class="hero-home">

<div class="hero-grade">

<div class="hero-texto">

<span class="hero-selo">⚒ Miniaturas para seu RPG e jogos de tabuleiro</span>

<h1>
Perfeitas para suas aventuras!
</h1>

<p>
Heróis, vilões, monstros e cenários para dar vida às suas jogatinas.
</p>

<span class="placa-sombra">
<a class="placa" href={url('/galeria')}>
VER PORTFÓLIO <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
</a>
</span>

<div class="hero-numeros">
<div><b>{totalTexto}</b>miniaturas</div>
<div><b>Toda semana</b>novidades</div>
</div>

</div>

{vitrine.length > 0 && (
<div class="hero-vitrine">
{vitrine.map(m => (
<a class="carta" href={m.href} title={m.titulo}>
<img src={asset(m.imagem)} alt={m.titulo} loading="eager"/>
</a>
))}
</div>
)}

</div>

<!-- Fitas de isolamento cruzadas, rolando em sentidos opostos (param com o mouse em cima). -->
<div class="fitas" aria-label="Atualizações semanais. Heróis, vilões, monstros e cenários.">

<div class="fita fita-amarela" aria-hidden="true"><div class="trilho">
<span class="item">Atualizações semanais 🔥<i class="sep"></i>Novas miniaturas toda semana<i class="sep"></i></span>
<span class="item">Atualizações semanais 🔥<i class="sep"></i>Novas miniaturas toda semana<i class="sep"></i></span>
<span class="item">Atualizações semanais 🔥<i class="sep"></i>Novas miniaturas toda semana<i class="sep"></i></span>
<span class="item">Atualizações semanais 🔥<i class="sep"></i>Novas miniaturas toda semana<i class="sep"></i></span>
</div></div>

<div class="fita fita-preta" aria-hidden="true"><div class="trilho">
<span class="item">Heróis<i class="sep"></i>Vilões<i class="sep"></i>Monstros<i class="sep"></i>Cenários<i class="sep"></i></span>
<span class="item">Heróis<i class="sep"></i>Vilões<i class="sep"></i>Monstros<i class="sep"></i>Cenários<i class="sep"></i></span>
<span class="item">Heróis<i class="sep"></i>Vilões<i class="sep"></i>Monstros<i class="sep"></i>Cenários<i class="sep"></i></span>
<span class="item">Heróis<i class="sep"></i>Vilões<i class="sep"></i>Monstros<i class="sep"></i>Cenários<i class="sep"></i></span>
</div></div>

</div>

<div class="hero-contato">
Não encontrou o que procura? <strong>Entre em contato com a gente!</strong>
</div>

</section>

<script is:inline>
/* Fitas: repete o texto até cobrir 2x a largura, para o loop não deixar buraco. */
document.querySelectorAll(".hero-home .trilho").forEach(trilho=>{
const base=[...trilho.children].map(el=>el.cloneNode(true));
const largura=trilho.parentElement.getBoundingClientRect().width;
while(trilho.scrollWidth<largura*2.2){ base.forEach(el=>trilho.append(el.cloneNode(true))); }
if(trilho.children.length % (base.length*2)){ base.forEach(el=>trilho.append(el.cloneNode(true))); }
});
</script>

<section class="container py-4">

<div class="destaques-topo text-center">

<h2>
Destaques
</h2>

<p>
Uma seleção do nosso catálogo.
</p>

</div>

{
miniaturas.length===0
? (
<p class="text-center text-muted">
Nenhuma miniatura cadastrada ainda.
</p>
)
: (
<div
id="vitrine-aleatoria"
class="row g-3"
></div>
)
}

<div class="text-center mt-4">

<span class="placa-sombra">
<a class="placa" href={url('/galeria')}>
VER TODAS AS MINIATURAS <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
</a>
</span>

</div>

</section>

<script
type="application/json"
id="miniaturas-data"
set:html={JSON.stringify(miniaturas)}
/>

<script is:inline>

const base =
document
.querySelector(
"base"
)
?.href || "/";

const dados =
JSON.parse(
document
.querySelector(
"#miniaturas-data"
)
.textContent
);

const container =
document.querySelector(
"#vitrine-aleatoria"
);

function asset(p){

if(
/^https?:\/\//.test(p)
){

return p;

}

return `${base}${p}`.replace(
/\/{2,}/g,
"/"
);

}

function embaralhar(lista){

return [...lista].sort(
()=>Math.random()-.5
);

}

function criarBadges(lista,tipo){

return lista.map(item=>`

<span class="badge badge-home badge-${tipo}">
${item}
</span>

`).join("");

}

function criarCard(mini){

const href =
mini.href;

const img =
asset(mini.imagem);

return `

<div class="col-6 col-lg-4">

<a href="${href}" class="text-decoration-none text-reset">

<div class="card card-home h-100 shadow-sm border-0">

<img
src="${img}"
class="card-img-top"
alt="${mini.titulo}"
/>

<div class="card-body">

<h3 class="card-title mb-2">
${mini.titulo}
</h3>

<div class="d-flex flex-wrap align-items-start gap-1">

${mini.culturaPop ? '<span class="badge-pop badge-pop-home"><span class="badge-pop-in"><span class="pop-star">★</span> Cultura Pop</span></span>' : ""}
${criarBadges(mini.classes,"classe")}
${criarBadges(mini.racas,"raca")}
${criarBadges(mini.sexo,"sexo")}
${criarBadges(mini.cenarios,"cenario")}

</div>

</div>

</div>

</a>

</div>

`;

}

const sorteadasTopo =
embaralhar(dados);

document
.querySelectorAll(
".hero-vitrine .carta"
)
.forEach((carta,i)=>{

const mini=
sorteadasTopo[i];

if(!mini){

return;

}

carta.href=mini.href;
carta.title=mini.titulo;

const img=
carta.querySelector("img");

img.src=asset(mini.imagem);
img.alt=mini.titulo;

});

if(
container
){

/* Sorteia uma vez: as 3 primeiras vão para os cards do topo e as
6 seguintes para os Destaques (assim nenhuma aparece repetida). */
const sorteadas =
sorteadasTopo;

container.innerHTML =
sorteadas
.slice(3,9)
.map(criarCard)
.join("");

}

</script>

<style>

.hero-home{

position:relative;
overflow:hidden;

/* Preto predominante, com brilho de brasa vermelho e laranja atrás dos cards. */
background:
radial-gradient(55% 75% at 85% 100%,rgba(255,110,20,.42) 0%,rgba(255,110,20,0) 62%),
radial-gradient(45% 65% at 72% 55%,rgba(190,25,15,.34) 0%,rgba(190,25,15,0) 70%),
radial-gradient(35% 45% at 8% 0%,rgba(190,25,15,.16) 0%,rgba(190,25,15,0) 70%),
linear-gradient(180deg,#0c0907 0%,#080605 100%);
color:#f1ece4;

}

.hero-grade{

max-width:1140px;
margin:0 auto;
padding:56px 24px 36px;

display:grid;
grid-template-columns:.9fr 1.1fr;
gap:28px;
align-items:center;

}

.hero-selo{

color:#ffc107;

font-weight:800;
font-size:.85rem;
letter-spacing:.08em;
text-transform:uppercase;

}

.hero-home h1{

margin:12px 0 14px;

font-size:clamp(2.1rem,4.4vw,3.6rem);
font-weight:900;
line-height:1.05;

color:var(--kl-gold);

}

.hero-home p{

margin:0 0 28px;
max-width:480px;

font-size:1.08rem;
line-height:1.5;

color:rgba(241,236,228,.82);

}

/* Botão em placa (mesma forma da barra lateral da galeria). */
.placa-sombra{

display:inline-flex;

filter:drop-shadow(4px 4px 0 #b8860b);

transition:transform .12s ease;

}

.placa-sombra:hover{

transform:translateY(-2px);

}

.placa{

--b:3px;
--h:56px;
--p:calc(var(--h) * .4);

position:relative;
isolation:isolate;

display:inline-flex;
align-items:center;
justify-content:center;
gap:.5em;

height:var(--h);
padding:0 calc(var(--p) + 22px);

background:#000;
color:#111;

font-weight:900;
font-size:1.05rem;
white-space:nowrap;
text-decoration:none;

clip-path:polygon(var(--p) 0,calc(100% - var(--p)) 0,100% 50%,calc(100% - var(--p)) 100%,var(--p) 100%,0 50%);

}

.placa::before{

--pi:calc(var(--p) - var(--b) * .8);

content:"";

position:absolute;
z-index:-1;

top:var(--b);
bottom:var(--b);
left:calc(var(--b) * 1.2806);
right:calc(var(--b) * 1.2806);

background:#ffc107;

clip-path:polygon(var(--pi) 0,calc(100% - var(--pi)) 0,100% 50%,calc(100% - var(--pi)) 100%,var(--pi) 100%,0 50%);

}

.placa:hover{

color:#111;

}

.ico{

width:1em;
height:1em;
flex:none;

}

.hero-numeros{

display:flex;
gap:28px;

margin-top:28px;

font-size:.85rem;
color:rgba(241,236,228,.7);

}

.hero-numeros b{

display:block;

font-size:1.5rem;
color:#fff;

}

/* Três miniaturas em leque. */
/* Os cards crescem junto com a coluna (até 300 x 375 px). */
.hero-vitrine{

position:relative;

width:100%;
aspect-ratio:5/4;
max-height:490px;

}

.carta{

position:absolute;

width:min(300px,51%);
aspect-ratio:4/5;

border-radius:16px;
border:4px solid #111;
overflow:hidden;

background:#333;

box-shadow:0 18px 40px rgba(0,0,0,.55);

transition:transform .2s ease;

}

.carta img{

width:100%;
height:100%;

object-fit:cover;

}

.carta:nth-child(1){

left:0;
top:12%;

transform:rotate(-8deg);

}

.carta:nth-child(2){

left:25%;
top:0;
z-index:2;

transform:rotate(2deg);

}

.carta:nth-child(3){

left:49%;
top:16%;

transform:rotate(9deg);

}

.carta:hover{

z-index:3;

transform:rotate(0) scale(1.05);

}

/* Fitas de isolamento. */
.fitas{

position:relative;

height:150px;

}

.fita{

position:absolute;
left:-6%;
right:-6%;

height:58px;

display:flex;
align-items:center;

overflow:hidden;

box-shadow:0 10px 18px rgba(0,0,0,.45);

}

.fita::before,
.fita::after{

content:"";

position:absolute;
left:0;
right:0;

height:9px;

background:repeating-linear-gradient(-45deg,#111 0 10px,#ffc107 10px 20px);

}

.fita::before{

top:0;

}

.fita::after{

bottom:0;

}

.fita-amarela{

top:22px;
z-index:2;

background:#ffc107;
color:#111;

transform:rotate(-2.5deg);

}

.fita-preta{

top:78px;

background:#141110;
color:#ffc107;

transform:rotate(1.8deg);

}

.fita-preta::before,
.fita-preta::after{

background:repeating-linear-gradient(-45deg,#ffc107 0 10px,#141110 10px 20px);

}

.trilho{

display:inline-flex;

white-space:nowrap;

animation:rolar 40s linear infinite;

}

.fita-preta .trilho{

animation-direction:reverse;
animation-duration:48s;

}

.fita:hover .trilho{

animation-play-state:paused;

}

.item{

display:inline-flex;
align-items:center;
gap:18px;

padding:0 18px;

font-weight:900;
font-size:1.05rem;
letter-spacing:.06em;
text-transform:uppercase;

}

.sep{

width:12px;
height:12px;

background:currentColor;

transform:rotate(45deg);

}

@keyframes rolar{

from{
transform:translateX(0);
}

to{
transform:translateX(-50%);
}

}

@media(prefers-reduced-motion:reduce){

.trilho{
animation:none;
}

}

.hero-contato{

padding:16px;

background:#070504;
border-top:1px solid rgba(255,110,20,.25);

text-align:center;
font-size:.95rem;

color:rgba(241,236,228,.85);

}

.hero-contato strong{

color:#ffc107;

}

.destaques-topo h2{

font-size:1.8rem;
font-weight:800;

margin-bottom:6px;

}

.destaques-topo p{

color:#6c757d;

margin-bottom:24px;

}

.card-home{

overflow:hidden;

transition:.2s ease;

}

.card-home:hover{

transform:translateY(-4px);

box-shadow:0 10px 24px rgba(0,0,0,.16) !important;

}

.card-home img{

width:100%;
aspect-ratio:1.35/1;
object-fit:cover;

}

.card-home .card-body{

padding:.8rem;

}

.card-home .card-title{

font-size:1.05rem;
font-weight:700;

}

:global(.badge-home){

display:inline-flex;
align-items:center;

padding:.3em .48em;

border-radius:.375rem;

font-size:.68rem;
font-weight:600;

line-height:1;

}

:global(.badge-classe){

background:#212529 !important;
color:#fff !important;

}

:global(.badge-raca){

background:#ffc107 !important;
color:#000 !important;

}

:global(.badge-sexo){

background:#b23a48 !important;
color:#fff !important;

}

:global(.badge-cenario){

background:#fff !important;
color:#212529 !important;

border:1px solid #dee2e6;

}

@media(max-width:768px){

.hero-grade{

grid-template-columns:1fr;

padding-top:44px;

text-align:center;

}

.hero-home p{

margin-left:auto;
margin-right:auto;

font-size:1rem;

}

.hero-numeros{

justify-content:center;

}

.hero-vitrine{

max-width:440px;

margin:0 auto;

}

.item{

font-size:.9rem;

}

.card-home img{

aspect-ratio:1/1;.card-home img{

aspect-ratio:1/1;

}

.card-home .card-body{

padding:.65rem;

}

.card-home .card-title{

font-size:.9rem;

}

:global(.badge-home){

font-size:.62rem;
padding:.28em .42em;

}

}

</style>

</Layout>

<style is:global>

/* Cultura Pop: placa hexagonal amarelo → rosa → roxo, borda preta e sombra rosa.
   .badge-pop          : só a sombra rosa
   .badge-pop-in       : placa preta (a borda), altura fixa --h, recortada em hexágono
   .badge-pop-in::before: miolo colorido recuado --b, com as diagonais paralelas às de fora
   Ponta = 0,4 × altura; recuo lateral = --b × 1,2806; ponta do miolo = ponta − 0,8 × --b. */

.badge-pop{
  --s:2px;
  display:inline-flex;
  vertical-align:middle;
  filter:drop-shadow(var(--s) var(--s) 0 #ff2e88);
}

.badge-pop-in{
  --b:1.5px;
  --h:1.7em;
  --p:calc(var(--h) * .4);
  position:relative;
  isolation:isolate;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:.35em;
  height:var(--h);
  padding:0 calc(var(--p) + .45em);
  font-size:.75rem;
  font-weight:800;
  line-height:1;
  color:#1a1a1a;
  white-space:nowrap;
  background:#111;
  clip-path:polygon(var(--p) 0,calc(100% - var(--p)) 0,100% 50%,calc(100% - var(--p)) 100%,var(--p) 100%,0 50%);
}

.badge-pop-in::before{
  --pi:calc(var(--p) - var(--b) * .8);
  content:"";
  position:absolute;
  z-index:-1;
  top:var(--b);
  bottom:var(--b);
  left:calc(var(--b) * 1.2806);
  right:calc(var(--b) * 1.2806);
  background:
    linear-gradient(180deg,rgba(255,255,255,.55) 0%,rgba(255,255,255,0) 48%),
    linear-gradient(100deg,#fff36b 0%,#ffd21f 38%,#ff7eb3 72%,#ff2e88 86%,#a33cf0 100%);
  clip-path:polygon(var(--pi) 0,calc(100% - var(--pi)) 0,100% 50%,calc(100% - var(--pi)) 100%,var(--pi) 100%,0 50%);
}

.pop-star{
  color:#ff2e88;
  height:1em;
  display:inline-flex;
  align-items:center;
}

/* Mesmo tamanho das etiquetas da home (.badge-home). */
.badge-pop-home .badge-pop-in{
  --h:1.6em;
  font-size:.68rem;
}

@media(max-width:768px){

  .badge-pop-home .badge-pop-in{
    --h:1.56em;
    font-size:.62rem;
  }

}

</style>
