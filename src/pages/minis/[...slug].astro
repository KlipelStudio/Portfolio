---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const minis = await getCollection('minis');

  return minis.map((m) => ({
    params: { slug: m.id },
    props: { mini: m }
  }));
}

const { mini } = Astro.props;
const { Content } = await render(mini);

const base = import.meta.env.BASE_URL;

const asset = (p) =>
  /^https?:\/\//.test(p)
    ? p
    : `${base}${p}`.replace(/\/{2,}/g, '/');

const imagens = [
  mini.data.imagem,
  ...(mini.data.galeria || [])
].filter(Boolean);
---

<Layout
  titulo={`${mini.data.titulo} — Klipel Studio`}
  descricao={mini.data.descricao}
>
  <section
    class="container pt-3 pb-0"
    style="overflow: hidden;"
  >
    <button
      class="btn btn-sm btn-outline-dark mb-4"
      onclick="history.back()"
      type="button"
    >
      ← Voltar
    </button>

    <div class="row g-4 align-items-start">

      <div class="col-lg-4">

        <h1 class="display-3 fw-bold mb-3">
          {mini.data.titulo}
        </h1>

        <div class="d-flex flex-wrap align-items-start gap-2 mb-4">

          {mini.data.culturaPop && (
            <span class="badge fs-6 badge-pop">
              <span class="pop-star">★</span> Cultura Pop
            </span>
          )}

          {mini.data.classes?.map((c) => (
            <span class="badge text-bg-dark fs-6">
              {c}
            </span>
          ))}

          {mini.data.racas?.map((r) => (
            <span
              class="badge fs-6"
              style="background:#ffc107;color:#000;"
            >
              {r}
            </span>
          ))}

          {mini.data.sexo?.map((s) => (
            <span
              class="badge fs-6"
              style="background:#b23a48;color:#fff;"
            >
              {s}
            </span>
          ))}

          {mini.data.cenarios?.map((c) => (
            <span
              class="badge fs-6 border"
              style="background:#fff;color:#000;border-color:#ced4da;"
            >
              {c}
            </span>
          ))}

        </div>

        {mini.data.descricao && (
          <p class="lead">
            {mini.data.descricao}
          </p>
        )}

        <article class="mt-4">
          <Content />
        </article>

      </div>

      <div class="col-lg-8 d-flex flex-column align-items-center">

        <img
          id="imagem-principal"
          src={asset(imagens[0])}
          alt={mini.data.titulo}
          class="rounded shadow-sm imagem-principal"
        />

        {imagens.length > 1 && (
          <div class="galeria-miniaturas mt-3">

            {imagens.map((img, index) => (
              <button
                class={`thumb-btn ${index === 0 ? 'thumb-ativa' : ''}`}
                type="button"
                data-img={asset(img)}
              >
                <img
                  src={asset(img)}
                  alt={`${mini.data.titulo} imagem ${index + 1}`}
                />
              </button>
            ))}

          </div>
        )}

      </div>

    </div>
  </section>

  <script is:inline>
    const imagemPrincipal =
    document.querySelector(
      "#imagem-principal"
    );

    document
    .querySelectorAll(
      ".thumb-btn"
    )
    .forEach(btn=>{

      btn.onclick=()=>{

        imagemPrincipal.src =
        btn.dataset.img;

        document
        .querySelectorAll(
          ".thumb-btn"
        )
        .forEach(b=>{

          b.classList.remove(
            "thumb-ativa"
          );

        });

        btn.classList.add(
          "thumb-ativa"
        );

      };

    });
  </script>

  <style>

  /* Cultura Pop: placa amarela com borda preta e base rosa (igual à galeria). */
.badge-pop{
  position:relative;
  isolation:isolate;
  display:inline-flex;
  align-items:center;
  gap:.3em;
  padding:.35em 1em;
  border:0;
  border-radius:0;
  background:#111;
  color:#111;
  font-weight:800;
  clip-path:polygon(9px 0,calc(100% - 9px) 0,100% 50%,calc(100% - 9px) 100%,9px 100%,0 50%);
}

.badge-pop::before{
  content:"";
  position:absolute;
  inset:1.5px;
  z-index:-1;
  background:linear-gradient(180deg,#fff27a 0%,#ffd21f 74%,#ff2e88 74%);
  clip-path:polygon(8px 0,calc(100% - 8px) 0,100% 50%,calc(100% - 8px) 100%,8px 100%,0 50%);
}

.pop-star{
  color:#ff2e88;
}

  .imagem-principal{
    max-height:75vh;
    max-width:100%;
    width:auto;
    object-fit:contain;
  }

  .galeria-miniaturas{
    width:100%;

    display:flex;
    gap:10px;

    overflow-x:auto;
    overflow-y:hidden;

    justify-content:flex-start;

    padding-bottom:8px;

    scroll-behavior:smooth;
  }

  .galeria-miniaturas::-webkit-scrollbar{
    height:8px;
  }

  .galeria-miniaturas::-webkit-scrollbar-track{
    background:#e9ecef;
    border-radius:999px;
  }

  .galeria-miniaturas::-webkit-scrollbar-thumb{
    background:#adb5bd;
    border-radius:999px;
  }

  .galeria-miniaturas::-webkit-scrollbar-thumb:hover{
    background:#868e96;
  }

  .thumb-btn{
    border:2px solid transparent;
    background:#fff;

    padding:4px;

    border-radius:8px;

    cursor:pointer;

    transition:.15s ease;

    flex:0 0 auto;
  }

  .thumb-btn:hover{
    border-color:#ffc107;
  }

  .thumb-btn.thumb-ativa{
    border-color:#212529;
  }

  .thumb-btn img{
    width:82px;
    height:82px;

    object-fit:cover;

    border-radius:6px;

    display:block;
  }

  @media(max-width:768px){

    .thumb-btn img{
      width:68px;
      height:68px;
    }

  }

  </style>
</Layout>
