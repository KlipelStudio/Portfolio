---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const minis = await getCollection('minis');

  return minis.map((m) => ({
    params: { slug: m.id },
    props: { mini: m }
  }));
}

const { mini } = Astro.props;
const { Content } = await render(mini);

const base = import.meta.env.BASE_URL;

const asset = (p) =>
  /^https?:\/\//.test(p)
    ? p
    : `${base}${p}`.replace(/\/{2,}/g, '/');

const imagens = [
  mini.data.imagem,
  ...(mini.data.galeria || [])
].filter(Boolean);
---

<Layout
  titulo={`${mini.data.titulo} — Klipel Studio`}
  descricao={mini.data.descricao}
>
  <section
    class="container pt-3 pb-0"
    style="overflow: hidden;"
  >
    <button
      class="btn btn-sm btn-outline-dark mb-4"
      onclick="history.back()"
      type="button"
    >
      ← Voltar
    </button>

    <div class="row g-4 align-items-start">

      <div class="col-lg-4">

        <h1 class="display-3 fw-bold mb-3">
          {mini.data.titulo}
        </h1>

        <div class="d-flex flex-wrap align-items-start gap-2 mb-4">

          {mini.data.culturaPop && (
            <span class="badge-pop badge-pop-pagina">
              <span class="badge-pop-in"><span class="pop-star">★</span> Cultura Pop</span>
            </span>
          )}

          {mini.data.classes?.map((c) => (
            <span class="badge text-bg-dark fs-6">
              {c}
            </span>
          ))}

          {mini.data.racas?.map((r) => (
            <span
              class="badge fs-6"
              style="background:#ffc107;color:#000;"
            >
              {r}
            </span>
          ))}

          {mini.data.sexo?.map((s) => (
            <span
              class="badge fs-6"
              style="background:#b23a48;color:#fff;"
            >
              {s}
            </span>
          ))}

          {mini.data.cenarios?.map((c) => (
            <span
              class="badge fs-6 border"
              style="background:#fff;color:#000;border-color:#ced4da;"
            >
              {c}
            </span>
          ))}

        </div>

        {mini.data.descricao && (
          <p class="lead">
            {mini.data.descricao}
          </p>
        )}

        <article class="mt-4">
          <Content />
        </article>

      </div>

      <div class="col-lg-8 d-flex flex-column align-items-center">

        <img
          id="imagem-principal"
          src={asset(imagens[0])}
          alt={mini.data.titulo}
          class="rounded shadow-sm imagem-principal"
        />

        {imagens.length > 1 && (
          <div class="galeria-miniaturas mt-3">

            {imagens.map((img, index) => (
              <button
                class={`thumb-btn ${index === 0 ? 'thumb-ativa' : ''}`}
                type="button"
                data-img={asset(img)}
              >
                <img
                  src={asset(img)}
                  alt={`${mini.data.titulo} imagem ${index + 1}`}
                />
              </button>
            ))}

          </div>
        )}

      </div>

    </div>
  </section>

  <script is:inline>
    const imagemPrincipal =
    document.querySelector(
      "#imagem-principal"
    );

    document
    .querySelectorAll(
      ".thumb-btn"
    )
    .forEach(btn=>{

      btn.onclick=()=>{

        imagemPrincipal.src =
        btn.dataset.img;

        document
        .querySelectorAll(
          ".thumb-btn"
        )
        .forEach(b=>{

          b.classList.remove(
            "thumb-ativa"
          );

        });

        btn.classList.add(
          "thumb-ativa"
        );

      };

    });
  </script>

  <style>

  .imagem-principal{
    max-height:75vh;
    max-width:100%;
    width:auto;
    object-fit:contain;
  }

  .galeria-miniaturas{
    width:100%;

    display:flex;
    gap:10px;

    overflow-x:auto;
    overflow-y:hidden;

    justify-content:flex-start;

    padding-bottom:8px;

    scroll-behavior:smooth;
  }

  .galeria-miniaturas::-webkit-scrollbar{
    height:8px;
  }

  .galeria-miniaturas::-webkit-scrollbar-track{
    background:#e9ecef;
    border-radius:999px;
  }

  .galeria-miniaturas::-webkit-scrollbar-thumb{
    background:#adb5bd;
    border-radius:999px;
  }

  .galeria-miniaturas::-webkit-scrollbar-thumb:hover{
    background:#868e96;
  }

  .thumb-btn{
    border:2px solid transparent;
    background:#fff;

    padding:4px;

    border-radius:8px;

    cursor:pointer;

    transition:.15s ease;

    flex:0 0 auto;
  }

  .thumb-btn:hover{
    border-color:#ffc107;
  }

  .thumb-btn.thumb-ativa{
    border-color:#212529;
  }

  .thumb-btn img{
    width:82px;
    height:82px;

    object-fit:cover;

    border-radius:6px;

    display:block;
  }

  @media(max-width:768px){

    .thumb-btn img{
      width:68px;
      height:68px;
    }

  }

  </style>
</Layout>

<style is:global>

/* Cultura Pop: placa hexagonal amarelo → rosa → roxo, borda preta e sombra rosa.
   .badge-pop          : só a sombra rosa
   .badge-pop-in       : placa preta (a borda), altura fixa --h, recortada em hexágono
   .badge-pop-in::before: miolo colorido recuado --b, com as diagonais paralelas às de fora
   Ponta = 0,4 × altura; recuo lateral = --b × 1,2806; ponta do miolo = ponta − 0,8 × --b. */

.badge-pop{
  --s:2px;
  display:inline-flex;
  vertical-align:middle;
  filter:drop-shadow(var(--s) var(--s) 0 #ff2e88);
}

.badge-pop-in{
  --b:1.5px;
  --h:1.7em;
  --p:calc(var(--h) * .4);
  position:relative;
  isolation:isolate;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:.35em;
  height:var(--h);
  padding:0 calc(var(--p) + .45em);
  font-size:.75rem;
  font-weight:800;
  line-height:1;
  color:#1a1a1a;
  white-space:nowrap;
  background:#111;
  clip-path:polygon(var(--p) 0,calc(100% - var(--p)) 0,100% 50%,calc(100% - var(--p)) 100%,var(--p) 100%,0 50%);
}

.badge-pop-in::before{
  --pi:calc(var(--p) - var(--b) * .8);
  content:"";
  position:absolute;
  z-index:-1;
  top:var(--b);
  bottom:var(--b);
  left:calc(var(--b) * 1.2806);
  right:calc(var(--b) * 1.2806);
  background:
    linear-gradient(180deg,rgba(255,255,255,.55) 0%,rgba(255,255,255,0) 48%),
    linear-gradient(100deg,#fff36b 0%,#ffd21f 38%,#ff7eb3 72%,#ff2e88 86%,#a33cf0 100%);
  clip-path:polygon(var(--pi) 0,calc(100% - var(--pi)) 0,100% 50%,calc(100% - var(--pi)) 100%,var(--pi) 100%,0 50%);
}

.pop-star{
  color:#ff2e88;
  height:1em;
  display:inline-flex;
  align-items:center;
}

/* Mesmo tamanho das etiquetas fs-6 da página; borda um pouco mais grossa. */
.badge-pop-pagina{
  --s:2.5px;
}

.badge-pop-pagina .badge-pop-in{
  --b:2px;
  font-size:1rem;
}

</style>
