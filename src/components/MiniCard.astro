---
const { mini } = Astro.props;

const base = import.meta.env.BASE_URL;

const asset = (p) =>
  /^https?:\/\//.test(p)
    ? p
    : `${base}${p}`.replace(/\/{2,}/g,'/');

const href = asset(`/minis/${mini.id}/`);
const img = asset(mini.data.imagem);
---

<a href={href} class="text-decoration-none text-reset">

  <div class="card card-mini h-100 shadow-sm border-0">

    <img
      src={img}
      class="card-img-top"
      alt={mini.data.titulo}
    />

    <div class="card-body">

      <h3 class="h5 card-title mb-1">
        {mini.data.titulo}
      </h3>

      <p class="card-text text-muted small mb-2">
        {mini.data.descricao}
      </p>

      <div class="d-flex flex-wrap align-items-start gap-1">

        {mini.data.culturaPop && (
          <span
            class="badge-pop badge-tag"
            data-filtro-tipo="pop"
            data-filtro-valor="Cultura Pop"
            title="Filtrar por Cultura Pop"
          >
            <span class="badge-pop-in"><span class="pop-star">★</span> Cultura Pop</span>
          </span>
        )}

        {mini.data.classes?.map(c => (
          <span
            class="badge badge-classe badge-tag"
            data-filtro-tipo="classe"
            data-filtro-valor={c}
            title={`Filtrar por ${c}`}
          >
            {c}
          </span>
        ))}

        {mini.data.racas?.map(r => (
          <span
            class="badge badge-raca badge-tag"
            data-filtro-tipo="raca"
            data-filtro-valor={r}
            title={`Filtrar por ${r}`}
          >
            {r}
          </span>
        ))}

        {mini.data.sexo?.map(s => (
          <span
            class="badge badge-sexo badge-tag"
            data-filtro-tipo="sexo"
            data-filtro-valor={s}
            title={`Filtrar por ${s}`}
          >
            {s}
          </span>
        ))}

        {mini.data.cenarios?.map(c => (
          <span
            class="badge badge-cenario badge-tag"
            data-filtro-tipo="cenario"
            data-filtro-valor={c}
            title={`Filtrar por ${c}`}
          >
            {c}
          </span>
        ))}

      </div>

    </div>

  </div>

</a>

<style>

.badge-classe{
  background:#212529;
  color:#fff;
  font-size:.75rem;
  font-weight:600;
}

.badge-raca{
  background:#ffc107;
  color:#000;
  font-size:.75rem;
  font-weight:600;
}

.badge-sexo{
  background:#b23a48;
  color:#fff;
  font-size:.75rem;
  font-weight:600;
}

.badge-cenario{
  background:#fff;
  color:#212529;
  border:1px solid #dee2e6;
  font-size:.75rem;
  font-weight:600;
}

/* Etiqueta clicável: adiciona o filtro na barra da esquerda. */
.badge-tag{
  cursor:pointer;
  transition:transform .12s ease, box-shadow .12s ease;
}

.badge-tag:hover{
  transform:translateY(-1px);
  box-shadow:0 0 0 2px rgba(0,0,0,.18);
}

</style>

<style is:global>

/* Cultura Pop: placa hexagonal amarelo → rosa → roxo, borda preta e sombra rosa.
   .badge-pop          : só a sombra rosa
   .badge-pop-in       : placa preta (a borda), altura fixa --h, recortada em hexágono
   .badge-pop-in::before: miolo colorido recuado --b, com as diagonais paralelas às de fora
   Ponta = 0,4 × altura; recuo lateral = --b × 1,2806; ponta do miolo = ponta − 0,8 × --b. */

.badge-pop{
  --s:2px;
  display:inline-flex;
  vertical-align:middle;
  filter:drop-shadow(var(--s) var(--s) 0 #ff2e88);
}

.badge-pop-in{
  --b:1.5px;
  --h:1.7em;
  --p:calc(var(--h) * .4);
  position:relative;
  isolation:isolate;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:.35em;
  height:var(--h);
  padding:0 calc(var(--p) + .45em);
  font-size:.75rem;
  font-weight:800;
  line-height:1;
  color:#1a1a1a;
  white-space:nowrap;
  background:#111;
  clip-path:polygon(var(--p) 0,calc(100% - var(--p)) 0,100% 50%,calc(100% - var(--p)) 100%,var(--p) 100%,0 50%);
}

.badge-pop-in::before{
  --pi:calc(var(--p) - var(--b) * .8);
  content:"";
  position:absolute;
  z-index:-1;
  top:var(--b);
  bottom:var(--b);
  left:calc(var(--b) * 1.2806);
  right:calc(var(--b) * 1.2806);
  background:
    linear-gradient(180deg,rgba(255,255,255,.55) 0%,rgba(255,255,255,0) 48%),
    linear-gradient(100deg,#fff36b 0%,#ffd21f 38%,#ff7eb3 72%,#ff2e88 86%,#a33cf0 100%);
  clip-path:polygon(var(--pi) 0,calc(100% - var(--pi)) 0,100% 50%,calc(100% - var(--pi)) 100%,var(--pi) 100%,0 50%);
}

.pop-star{
  color:#ff2e88;
  height:1em;
  display:inline-flex;
  align-items:center;
}

/* No card: sem o contorno de foco quadrado do hover das etiquetas. */
.badge-pop.badge-tag:hover{
  box-shadow:none;
}

</style>
