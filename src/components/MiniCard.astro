---
const { mini } = Astro.props;

const base = import.meta.env.BASE_URL;

const asset = (p) =>
  /^https?:\/\//.test(p)
    ? p
    : `${base}${p}`.replace(/\/{2,}/g,'/');

const href = asset(`/minis/${mini.id}/`);
const img = asset(mini.data.imagem);
---

<a href={href} class="text-decoration-none text-reset">

  <div class="card card-mini h-100 shadow-sm border-0">

    <img
      src={img}
      class="card-img-top"
      alt={mini.data.titulo}
    />

    <div class="card-body">

      <h3 class="h5 card-title mb-1">
        {mini.data.titulo}
      </h3>

      <p class="card-text text-muted small mb-2">
        {mini.data.descricao}
      </p>

      <div class="d-flex flex-wrap gap-1">

        {mini.data.culturaPop && (
          <span
            class="badge badge-pop badge-tag"
            data-filtro-tipo="pop"
            data-filtro-valor="Cultura Pop"
            title="Filtrar por Cultura Pop"
          >
            ★ Cultura Pop
          </span>
        )}

        {mini.data.classes?.map(c => (
          <span
            class="badge badge-classe badge-tag"
            data-filtro-tipo="classe"
            data-filtro-valor={c}
            title={`Filtrar por ${c}`}
          >
            {c}
          </span>
        ))}

        {mini.data.racas?.map(r => (
          <span
            class="badge badge-raca badge-tag"
            data-filtro-tipo="raca"
            data-filtro-valor={r}
            title={`Filtrar por ${r}`}
          >
            {r}
          </span>
        ))}

        {mini.data.sexo?.map(s => (
          <span
            class="badge badge-sexo badge-tag"
            data-filtro-tipo="sexo"
            data-filtro-valor={s}
            title={`Filtrar por ${s}`}
          >
            {s}
          </span>
        ))}

        {mini.data.cenarios?.map(c => (
          <span
            class="badge badge-cenario badge-tag"
            data-filtro-tipo="cenario"
            data-filtro-valor={c}
            title={`Filtrar por ${c}`}
          >
            {c}
          </span>
        ))}

      </div>

    </div>

  </div>

</a>

<style>

.badge-classe{
  background:#212529;
  color:#fff;
  font-size:.75rem;
  font-weight:600;
}

.badge-raca{
  background:#ffc107;
  color:#000;
  font-size:.75rem;
  font-weight:600;
}

.badge-sexo{
  background:#b23a48;
  color:#fff;
  font-size:.75rem;
  font-weight:600;
}

.badge-cenario{
  background:#fff;
  color:#212529;
  border:1px solid #dee2e6;
  font-size:.75rem;
  font-weight:600;
}

/* Cultura Pop: balão de fala estilo quadrinho (rosa → roxo, contorno preto). */
.badge-pop{
  position:relative;
  margin-bottom:6px;
  padding:.32em .65em;
  background:linear-gradient(135deg,#ff2e88 0%,#a33cf0 100%);
  color:#fff;
  border:2px solid #111;
  border-radius:12px;
  font-size:.75rem;
  font-weight:800;
  letter-spacing:.02em;
  text-shadow:1px 1px 0 rgba(0,0,0,.35);
}

.badge-pop::after{
  content:"";
  position:absolute;
  left:12px;
  bottom:-6px;
  width:9px;
  height:9px;
  background:#f8318f;
  border-right:2px solid #111;
  border-bottom:2px solid #111;
  transform:rotate(45deg);
}

/* Etiqueta clicável: adiciona o filtro na barra da esquerda. */
.badge-tag{
  cursor:pointer;
  transition:transform .12s ease, box-shadow .12s ease;
}

.badge-tag:hover{
  transform:translateY(-1px);
  box-shadow:0 0 0 2px rgba(0,0,0,.18);
}

</style>
