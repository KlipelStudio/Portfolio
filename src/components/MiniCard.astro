---
const { mini } = Astro.props;

const base = import.meta.env.BASE_URL;

const asset = (p) =>
  /^https?:\/\//.test(p)
    ? p
    : `${base}${p}`.replace(/\/{2,}/g,'/');

const href = asset(`/minis/${mini.id}/`);
const img = asset(mini.data.imagem);
---

<a href={href} class="text-decoration-none text-reset">

  <div class="card card-mini h-100 shadow-sm border-0">

    <img
      src={img}
      class="card-img-top"
      alt={mini.data.titulo}
    />

    <div class="card-body">

      <h3 class="h5 card-title mb-1">
        {mini.data.titulo}
      </h3>

      <p class="card-text text-muted small mb-2">
        {mini.data.descricao}
      </p>

      <div class="d-flex flex-wrap align-items-start gap-1">

        {mini.data.culturaPop && (
          <span
            class="badge badge-pop badge-tag"
            data-filtro-tipo="pop"
            data-filtro-valor="Cultura Pop"
            title="Filtrar por Cultura Pop"
          >
            <span class="pop-star">★</span> Cultura Pop
          </span>
        )}

        {mini.data.classes?.map(c => (
          <span
            class="badge badge-classe badge-tag"
            data-filtro-tipo="classe"
            data-filtro-valor={c}
            title={`Filtrar por ${c}`}
          >
            {c}
          </span>
        ))}

        {mini.data.racas?.map(r => (
          <span
            class="badge badge-raca badge-tag"
            data-filtro-tipo="raca"
            data-filtro-valor={r}
            title={`Filtrar por ${r}`}
          >
            {r}
          </span>
        ))}

        {mini.data.sexo?.map(s => (
          <span
            class="badge badge-sexo badge-tag"
            data-filtro-tipo="sexo"
            data-filtro-valor={s}
            title={`Filtrar por ${s}`}
          >
            {s}
          </span>
        ))}

        {mini.data.cenarios?.map(c => (
          <span
            class="badge badge-cenario badge-tag"
            data-filtro-tipo="cenario"
            data-filtro-valor={c}
            title={`Filtrar por ${c}`}
          >
            {c}
          </span>
        ))}

      </div>

    </div>

  </div>

</a>

<style>

.badge-classe{
  background:#212529;
  color:#fff;
  font-size:.75rem;
  font-weight:600;
}

.badge-raca{
  background:#ffc107;
  color:#000;
  font-size:.75rem;
  font-weight:600;
}

.badge-sexo{
  background:#b23a48;
  color:#fff;
  font-size:.75rem;
  font-weight:600;
}

.badge-cenario{
  background:#fff;
  color:#212529;
  border:1px solid #dee2e6;
  font-size:.75rem;
  font-weight:600;
}

/* Cultura Pop: placa amarela com borda preta e base rosa.
   Mesma altura das outras etiquetas (sem borda nem margem extra). */
.badge-pop{
  position:relative;
  isolation:isolate;
  display:inline-flex;
  align-items:center;
  gap:.3em;
  padding:.35em .85em;
  border:0;
  border-radius:0;
  background:#111;
  color:#111;
  font-weight:800;
  clip-path:polygon(7px 0,calc(100% - 7px) 0,100% 50%,calc(100% - 7px) 100%,7px 100%,0 50%);
  font-size:.75rem;
  line-height:1;
}

.badge-pop::before{
  content:"";
  position:absolute;
  inset:1.5px;
  z-index:-1;
  background:linear-gradient(180deg,#fff27a 0%,#ffd21f 74%,#ff2e88 74%);
  clip-path:polygon(6px 0,calc(100% - 6px) 0,100% 50%,calc(100% - 6px) 100%,6px 100%,0 50%);
}

.pop-star{
  color:#ff2e88;
}

/* Etiqueta clicável: adiciona o filtro na barra da esquerda. */
.badge-tag{
  cursor:pointer;
  transition:transform .12s ease, box-shadow .12s ease;
}

.badge-tag:hover{
  transform:translateY(-1px);
  box-shadow:0 0 0 2px rgba(0,0,0,.18);
}

</style>
