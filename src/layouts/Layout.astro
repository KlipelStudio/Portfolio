---
const { titulo = 'Klipel Studio', descricao = 'Miniaturas artesanais para aventureiros de RPG.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (p) => `${base}${p}`.replace(/\/{2,}/g, '/');
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="robots" content="noindex, nofollow"/>
<meta name="googlebot" content="noindex, nofollow"/>
<title>{titulo}</title>

<!-- Ícone do site (aba do navegador, favoritos e tela inicial do celular) -->
<link rel="icon" href={url('/favicon.ico')} sizes="48x48"/>
<link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')}/>
<link rel="icon" type="image/png" sizes="192x192" href={url('/favicon-192.png')}/>
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')}/>
<meta name="description" content={descricao}/>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
/>

<style>
:root{
--kl-dark:#1a1410;
--kl-gold:#c9a45c;
}

body{
font-family:system-ui,sans-serif;
}

.hero{
background:linear-gradient(rgba(26,20,16,.78), rgba(26,20,16,.92));
}

.text-gold{
color:var(--kl-gold)!important;
}

.bg-forge{
background:var(--kl-dark);
}

.card-mini img{
aspect-ratio:4/3;
object-fit:cover;
}
</style>
</head>

<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-dark bg-forge border-bottom">
<div class="container">

<a
class="navbar-brand fw-bold text-gold"
href={url('/')}
>
Klipel Studio
</a>

<div class="ms-auto">
<a
class:list={["nav-link text-light",{active:path==="/galeria/"}]}
href={url('/galeria')}
>
Galeria
</a>
</div>

</div>
</nav>

<main class="flex-grow-1">
<slot/>
</main>

<!-- Aviso de cookies: as estatísticas só ligam depois de "Aceitar". -->
<div
id="kl-cookies"
class="kl-cookies"
role="dialog"
aria-live="polite"
aria-label="Aviso de cookies"
hidden
>

<p class="kl-cookies-texto">
Usamos cookies do Google Analytics e do Microsoft Clarity para entender, de forma
anônima, como o site é usado (páginas vistas, filtros e buscas).
<a href={url('/privacidade') + '#estatisticas'}>Saiba mais</a>
</p>

<div class="kl-cookies-botoes">
<button type="button" class="kl-cookies-recusar" data-cookies="recusado">
Recusar
</button>
<button type="button" class="kl-cookies-aceitar" data-cookies="aceito">
Aceitar
</button>
</div>

</div>

<script is:inline define:vars={{ GA_ID: "G-6W594PX3WH", CLARITY_ID: "z81civsyg3" }}>
(function(){

var CHAVE="kl-consentimento";
var ligado=false;
var aviso=document.getElementById("kl-cookies");

function ler(){
try{ return localStorage.getItem(CHAVE); }catch(e){ return null; }
}

function salvar(valor){
try{ localStorage.setItem(CHAVE,valor); }catch(e){}
}

/* Eventos do site (filtros, busca...). Só envia se as estatísticas estiverem ligadas. */
window.klEvento=function(nome,dados){
if(!ligado){ return; }
dados=dados||{};
try{
if(window.gtag){ window.gtag("event",nome,dados); }
if(window.clarity){
window.clarity("event",nome);
if(dados.valor){ window.clarity("set",nome,String(dados.valor)); }
if(dados.termo){ window.clarity("set",nome,String(dados.termo)); }
}
}catch(e){}
};

function carregar(){
if(ligado){ return; }
ligado=true;

/* Google Analytics 4 */
window.dataLayer=window.dataLayer||[];
window.gtag=function(){ window.dataLayer.push(arguments); };
window.gtag("js",new Date());
window.gtag("config",GA_ID);
var ga=document.createElement("script");
ga.async=true;
ga.src="https://www.googletagmanager.com/gtag/js?id="+GA_ID;
document.head.appendChild(ga);

/* Microsoft Clarity */
(function(c,l,a,r,i,t,y){
c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window,document,"clarity","script",CLARITY_ID);
window.clarity("consent");
}

function apagarCookies(){
document.cookie.split(";").forEach(function(item){
var nome=item.split("=")[0].trim();
if(/^(_ga|_gid|_gat|_clck|_clsk|CLID|MUID)/.test(nome)){
var dominios=["",location.hostname,"."+location.hostname];
dominios.forEach(function(d){
document.cookie=nome+"=; Max-Age=0; path=/"+(d?"; domain="+d:"");
});
}
});
}

function mostrar(){ if(aviso){ aviso.hidden=false; } }
function esconder(){ if(aviso){ aviso.hidden=true; } }

/* Página de privacidade: botão "Alterar minha escolha". */
window.klCookies=mostrar;

if(aviso){
aviso.addEventListener("click",function(evento){
var botao=evento.target.closest("[data-cookies]");
if(!botao){ return; }
var escolha=botao.getAttribute("data-cookies");
var antes=ler();
salvar(escolha);
esconder();
if(escolha==="aceito"){
carregar();
}else if(antes==="aceito"){
/* Desligou: apaga os cookies e recarrega para parar os scripts. */
apagarCookies();
location.reload();
}
});
}

var escolha=ler();
if(escolha==="aceito"){
carregar();
}else if(escolha!=="recusado"){
mostrar();
}

})();
</script>

<style>

.kl-cookies{
position:fixed;
left:16px;
right:16px;
bottom:16px;
z-index:2000;
max-width:760px;
margin:0 auto;
display:flex;
align-items:center;
gap:16px;
padding:14px 16px;
background:var(--kl-dark);
color:#f1ece4;
border:2px solid var(--kl-gold);
border-radius:12px;
box-shadow:0 10px 30px rgba(0,0,0,.35);
}

.kl-cookies[hidden]{
display:none;
}

.kl-cookies-texto{
margin:0;
font-size:.9rem;
line-height:1.45;
}

.kl-cookies-texto a{
color:var(--kl-gold);
}

.kl-cookies-botoes{
display:flex;
gap:8px;
flex:none;
}

.kl-cookies-botoes button{
padding:8px 16px;
border-radius:8px;
font-weight:700;
cursor:pointer;
}

.kl-cookies-recusar{
background:transparent;
color:#f1ece4;
border:1.5px solid rgba(241,236,228,.55);
}

.kl-cookies-aceitar{
background:#ffc107;
color:#111;
border:1.5px solid #ffc107;
}

@media(max-width:576px){

.kl-cookies{
flex-direction:column;
align-items:stretch;
}

.kl-cookies-botoes button{
flex:1;
}

}

</style>

<!-- Dica animada reutilizável: anel pulsando + mão tocando + balão.
     Uso: window.klDica(elemento, { nome, frase: "texto com {nome}", duracao, aoFechar }) -->
<script is:inline>
window.klDica=function(alvo,opcoes){

opcoes=opcoes||{};

var fechada=false;
var timer=null;

function escapar(texto){
return String(texto).replace(/[&<>"]/g,function(c){
return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c];
});
}

var frase=String(opcoes.frase||"").replace(
"{nome}",
"<b>“"+escapar(opcoes.nome||"")+"”</b>"
);

var caixa=document.createElement("div");
caixa.className="kl-dica";
caixa.innerHTML=
'<div class="kl-dica-anel"></div>'+
'<div class="kl-dica-mao" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0-.5V4.5a1.5 1.5 0 0 1 3 0V10m0-1a1.5 1.5 0 0 1 3 0v4.5c0 3.6-2.4 6.5-6 6.5h-.6a6 6 0 0 1-4.6-2.2L4.4 14.7a1.5 1.5 0 0 1 2.3-1.9L9 15V11"/></svg></div>'+
'<div class="kl-dica-balao" role="status"><strong>Dica</strong>'+frase+
'<button type="button">Entendi</button></div>';

function posicionar(){

var r=alvo.getBoundingClientRect();

var anel=caixa.querySelector(".kl-dica-anel");
anel.style.left=(r.left-6)+"px";
anel.style.top=(r.top-6)+"px";
anel.style.width=(r.width+12)+"px";
anel.style.height=(r.height+12)+"px";

var mao=caixa.querySelector(".kl-dica-mao");
mao.style.left=(r.left+r.width/2-6)+"px";
mao.style.top=(r.top+r.height/2-2)+"px";

var balao=caixa.querySelector(".kl-dica-balao");
var largura=Math.min(280,innerWidth-24);
balao.style.width=largura+"px";

var esquerda=r.left+r.width/2-largura/2;
esquerda=Math.max(12,Math.min(esquerda,innerWidth-largura-12));

balao.style.left=esquerda+"px";
balao.style.top=(r.bottom+46)+"px";
balao.style.setProperty("--seta",(r.left+r.width/2-esquerda)+"px");

}

function aoClicar(evento){
if(evento.target.closest("[data-filtro-tipo], .etiqueta-link")){
fechar("clicou_etiqueta");
}
}

function fechar(acao){

if(fechada){ return; }

fechada=true;
clearTimeout(timer);

removeEventListener("scroll",posicionar);
removeEventListener("resize",posicionar);
document.removeEventListener("click",aoClicar,true);

if(typeof opcoes.aoFechar==="function"){
try{ opcoes.aoFechar(acao); }catch(e){}
}

caixa.classList.add("kl-dica-saindo");
setTimeout(function(){ caixa.remove(); },250);

}

document.body.appendChild(caixa);
caixa.querySelector("button").onclick=function(){ fechar("entendi"); };

posicionar();

addEventListener("scroll",posicionar,{passive:true});
addEventListener("resize",posicionar);
document.addEventListener("click",aoClicar,true);

timer=setTimeout(function(){ fechar("sumiu_sozinha"); },opcoes.duracao||10000);

return { fechar:fechar };

};
</script>

<style is:global>

/* Dica animada (mão apontando para uma etiqueta). */
.kl-dica{
  position:fixed;
  inset:0;
  z-index:1500;
  pointer-events:none;
  animation:kl-dica-entra .3s ease;
}

.kl-dica-saindo{
  opacity:0;
  transition:opacity .25s ease;
}

.kl-dica-anel{
  position:fixed;
  border-radius:10px;
  border:3px solid #ffc107;
  animation:kl-dica-pulso 1.4s ease-out infinite;
}

.kl-dica-mao{
  position:fixed;
  width:44px;
  height:44px;
  animation:kl-dica-toque 1.4s ease-in-out infinite;
  transform-origin:12px 6px;
}

.kl-dica-mao svg{
  width:100%;
  height:100%;
  fill:#fff;
  stroke:#111;
  stroke-width:1.6;
  stroke-linejoin:round;
  filter:drop-shadow(2px 3px 2px rgba(0,0,0,.45));
}

.kl-dica-balao{
  --seta:50%;
  position:fixed;
  pointer-events:auto;
  padding:12px 14px;
  background:#1a1410;
  color:#f1ece4;
  border:2px solid #ffc107;
  border-radius:12px;
  box-shadow:0 10px 26px rgba(0,0,0,.35);
  font-size:.9rem;
  line-height:1.4;
}

.kl-dica-balao::before{
  content:"";
  position:absolute;
  top:-9px;
  left:calc(var(--seta) - 8px);
  width:14px;
  height:14px;
  background:#1a1410;
  border-left:2px solid #ffc107;
  border-top:2px solid #ffc107;
  transform:rotate(45deg);
}

.kl-dica-balao strong{
  display:block;
  margin-bottom:2px;
  color:#ffc107;
  font-size:.75rem;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.kl-dica-balao b{
  color:#ffc107;
}

.kl-dica-balao button{
  display:block;
  margin:10px 0 0 auto;
  padding:6px 14px;
  border:0;
  border-radius:8px;
  background:#ffc107;
  color:#111;
  font-weight:800;
  cursor:pointer;
}

@keyframes kl-dica-entra{
  from{ opacity:0; }
  to{ opacity:1; }
}

@keyframes kl-dica-pulso{
  0%{ box-shadow:0 0 0 0 rgba(255,193,7,.7); }
  100%{ box-shadow:0 0 0 14px rgba(255,193,7,0); }
}

/* A mão vem de baixo e "toca" a etiqueta. */
@keyframes kl-dica-toque{
  0%{ transform:translate(26px,34px); opacity:0; }
  25%{ transform:translate(0,0); opacity:1; }
  40%{ transform:translate(0,0) scale(.85); }
  55%{ transform:translate(0,0) scale(1); }
  85%{ transform:translate(0,0); opacity:1; }
  100%{ transform:translate(26px,34px); opacity:0; }
}

@media(prefers-reduced-motion:reduce){
  .kl-dica-mao,
  .kl-dica-anel{
    animation:none;
  }
}

</style>

</body>
</html>
