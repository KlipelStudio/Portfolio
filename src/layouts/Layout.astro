---
const { titulo = 'Klipel Studio', descricao = 'Miniaturas artesanais para aventureiros de RPG.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (p) => `${base}${p}`.replace(/\/{2,}/g, '/');
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
<meta charset="utf-8"/>

<!-- Tema (lua = escuro, padrão; sol = claro). Roda antes de pintar a página. -->
<script is:inline>
try{
if(localStorage.getItem("kl-tema")==="claro"){
document.documentElement.setAttribute("data-bs-theme","light");
}
}catch(e){}
</script>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="robots" content="noindex, nofollow"/>
<meta name="googlebot" content="noindex, nofollow"/>
<title>{titulo}</title>

<!-- Ícone do site (aba do navegador, favoritos e tela inicial do celular) -->
<link rel="icon" href={url('/favicon.ico')} sizes="48x48"/>
<link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')}/>
<link rel="icon" type="image/png" sizes="192x192" href={url('/favicon-192.png')}/>
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')}/>
<meta name="description" content={descricao}/>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
/>

<style>
:root{
--kl-dark:#1a1410;
--kl-gold:#c9a45c;
}

body{
font-family:system-ui,sans-serif;
}

.hero{
background:linear-gradient(rgba(26,20,16,.78), rgba(26,20,16,.92));
}

.text-gold{
color:var(--kl-gold)!important;
}

.bg-forge{
background:var(--kl-dark);
}

.card-mini img{
aspect-ratio:4/3;
object-fit:cover;
}
</style>
</head>

<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-dark bg-forge border-bottom">
<div class="container">

<a
class="navbar-brand fw-bold text-gold"
href={url('/')}
>
Klipel Studio
</a>

<div class="ms-auto d-flex align-items-center gap-3">
<a
class:list={["nav-link text-light",{active:path==="/galeria/"}]}
href={url('/galeria')}
>
Galeria
</a>

<!-- Sol = tema claro; lua = tema escuro (padrão). -->
<div class="kl-tema" role="group" aria-label="Tema do site">
<button type="button" class="kl-tema-btn" data-tema="claro" title="Tema claro" aria-label="Tema claro"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg></button>
<button type="button" class="kl-tema-btn" data-tema="escuro" title="Tema escuro" aria-label="Tema escuro"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"/></svg></button>
</div>
</div>

</div>
</nav>

<main class="flex-grow-1">
<slot/>
</main>


<script is:inline>
/* Troca de tema pelo sol/lua da barra de cima (fica lembrado no navegador). */
document.querySelectorAll(".kl-tema-btn").forEach(function(botao){
botao.addEventListener("click",function(){
var tema=botao.getAttribute("data-tema");
document.documentElement.setAttribute("data-bs-theme",tema==="claro"?"light":"dark");
try{ localStorage.setItem("kl-tema",tema); }catch(e){}
if(window.klEvento){ window.klEvento("tema",{tema:tema}); }
});
});
</script>

<!-- Chat de recados: sugestões, pedidos, reclamações... (vai para o WhatsApp do Klipel Studio). -->
<div id="kl-chat" class="kl-chat">

<div id="kl-chat-painel" class="kl-chat-painel" role="dialog" aria-label="Fale com a gente" hidden>

<div class="kl-chat-topo">
<div>
<strong>Fale com a gente</strong>
<small>Sugestões, pedidos, reclamações ou o que quiser.</small>
</div>
<button type="button" class="kl-chat-fechar" aria-label="Fechar">×</button>
</div>

<form class="kl-chat-form" novalidate>

<div class="kl-chat-tipos" role="radiogroup" aria-label="Assunto (opcional)">
<label><input type="radio" name="tipo" value="Sugestão"/><span>Sugestão</span></label>
<label><input type="radio" name="tipo" value="Pedido"/><span>Pedido</span></label>
<label><input type="radio" name="tipo" value="Reclamação"/><span>Reclamação</span></label>
<label><input type="radio" name="tipo" value="Outro"/><span>Outro</span></label>
</div>

<label class="kl-chat-campo">
Sua mensagem *
<textarea name="mensagem" rows="4" maxlength="1500" required placeholder="Ex.: Queria uma miniatura de um mago anão..."></textarea>
</label>
<span class="kl-chat-erro" hidden></span>

<label class="kl-chat-campo">
Contato <small>(opcional, para a gente responder)</small>
<input name="contato" maxlength="120" autocomplete="off" placeholder="WhatsApp, e-mail ou Instagram"/>
</label>

<!-- Armadilha para robôs: pessoas não veem este campo. -->
<input type="text" name="site" class="kl-chat-armadilha" tabindex="-1" autocomplete="off" aria-hidden="true"/>

<button type="submit" class="kl-chat-enviar">Enviar</button>

<p class="kl-chat-aviso">
Sua mensagem vai direto para a equipe do Klipel Studio.
<a href={url('/privacidade') + '#chat'}>Privacidade</a>
</p>

</form>

<div class="kl-chat-ok" hidden>
<strong>Recebemos! 🙌</strong>
<p>Obrigado pela mensagem. Se você deixou um contato, a gente responde por lá.</p>
<button type="button" class="kl-chat-outra">Enviar outra mensagem</button>
</div>

</div>

<button type="button" class="kl-chat-botao" aria-expanded="false" aria-controls="kl-chat-painel" title="Fale com a gente">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.6.5-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5z"/><path d="M8 8.5h8M8 11.5h5"/></svg>
<span class="kl-chat-rotulo">Fale com a gente</span>
</button>

</div>

<script is:inline define:vars={{ CHAT_URL: "https://script.google.com/macros/s/AKfycbyQ9PcAyCxWZ4Kwz4ONlHGk96c_qgfGg0OMVd--x4fOiqy9LVnt2MRPiLzhr9jGvDpzow/exec" }}>
(function(){

var raiz=document.getElementById("kl-chat");
if(!raiz){ return; }

/* Sem o endereço do backend, o chat não aparece e "Entre em contato" vira texto. */
if(!CHAT_URL){
raiz.remove();
document.querySelectorAll("[data-abrir-chat]").forEach(function(el){
var texto=document.createElement("strong");
texto.textContent=el.textContent;
el.replaceWith(texto);
});
return;
}

var painel=raiz.querySelector(".kl-chat-painel");
var botao=raiz.querySelector(".kl-chat-botao");
var form=raiz.querySelector(".kl-chat-form");
var texto=form.querySelector("textarea");
var erro=form.querySelector(".kl-chat-erro");
var enviar=form.querySelector(".kl-chat-enviar");
var ok=raiz.querySelector(".kl-chat-ok");

function evento(nome,dados){
if(window.klEvento){ window.klEvento(nome,dados||{}); }
}

function abrir(opcoes){
opcoes=opcoes||{};
painel.hidden=false;
raiz.classList.add("aberto");
botao.setAttribute("aria-expanded","true");
if(opcoes.piscar){
/* Pisca para chamar atenção (ex.: clicou em "Entre em contato"). */
painel.classList.remove("piscar");
void painel.offsetWidth;
painel.classList.add("piscar");
}
setTimeout(function(){ if(!ok.hidden){ return; } texto.focus(); },60);
evento("chat_aberto",{origem:opcoes.origem||"botao"});
}

function fechar(){
painel.hidden=true;
raiz.classList.remove("aberto");
botao.setAttribute("aria-expanded","false");
}

function mostrarErro(mensagem){
erro.textContent=mensagem;
erro.hidden=!mensagem;
}

window.klChatAbrir=abrir;

botao.addEventListener("click",function(){
if(painel.hidden){ abrir({origem:"botao"}); }else{ fechar(); }
});

raiz.querySelector(".kl-chat-fechar").addEventListener("click",fechar);

document.addEventListener("keydown",function(e){
if(e.key==="Escape"&&!painel.hidden){ fechar(); }
});

/* Qualquer elemento com data-abrir-chat abre o chat piscando. */
document.addEventListener("click",function(e){
var gatilho=e.target.closest("[data-abrir-chat]");
if(!gatilho){ return; }
e.preventDefault();
abrir({piscar:true,origem:gatilho.getAttribute("data-abrir-chat")||"contato"});
});

texto.addEventListener("input",function(){ mostrarErro(""); });

form.addEventListener("submit",function(e){

e.preventDefault();

var mensagem=texto.value.trim();
if(mensagem.length<3){
mostrarErro("Escreva sua mensagem.");
texto.focus();
return;
}

var marcado=form.querySelector('input[name="tipo"]:checked');

var dados={
mensagem:mensagem,
contato:form.contato.value.trim(),
tipo:marcado?marcado.value:"",
pagina:location.pathname+location.search,
site:form.site.value
};

if(!CHAT_URL){
mostrarErro("O chat ainda está sendo configurado. Tente de novo mais tarde.");
return;
}

enviar.disabled=true;
enviar.textContent="Enviando...";
mostrarErro("");

/* text/plain evita a checagem extra do navegador (o Apps Script aceita assim). */
fetch(CHAT_URL,{method:"POST",body:JSON.stringify(dados)})
.then(function(resposta){ return resposta.json(); })
.then(function(resultado){
if(!resultado||!resultado.ok){
throw new Error(resultado&&resultado.erro||"falhou");
}
form.reset();
form.hidden=true;
ok.hidden=false;
evento("chat_enviado",{tipo:dados.tipo||"sem_tipo"});
})
.catch(function(falha){
mostrarErro(String(falha.message)==="limite"
? "Muitas mensagens agora. Tente de novo em alguns minutos."
: "Não foi possível enviar agora. Tente de novo em instantes.");
})
.finally(function(){
enviar.disabled=false;
enviar.textContent="Enviar";
});

});

raiz.querySelector(".kl-chat-outra").addEventListener("click",function(){
ok.hidden=true;
form.hidden=false;
texto.focus();
});

})();
</script>

<!-- Aviso de cookies: as estatísticas só ligam depois de "Aceitar". -->
<div
id="kl-cookies"
class="kl-cookies"
role="dialog"
aria-live="polite"
aria-label="Aviso de cookies"
hidden
>

<p class="kl-cookies-texto">
Usamos cookies do Google Analytics e do Microsoft Clarity para entender, de forma
anônima, como o site é usado (páginas vistas, filtros e buscas).
<a href={url('/privacidade') + '#estatisticas'}>Saiba mais</a>
</p>

<div class="kl-cookies-botoes">
<button type="button" class="kl-cookies-recusar" data-cookies="recusado">
Recusar
</button>
<button type="button" class="kl-cookies-aceitar" data-cookies="aceito">
Aceitar
</button>
</div>

</div>

<script is:inline define:vars={{ GA_ID: "G-6W594PX3WH", CLARITY_ID: "z81civsyg3" }}>
(function(){

var CHAVE="kl-consentimento";
var ligado=false;
var aviso=document.getElementById("kl-cookies");

function ler(){
try{ return localStorage.getItem(CHAVE); }catch(e){ return null; }
}

function salvar(valor){
try{ localStorage.setItem(CHAVE,valor); }catch(e){}
}

/* Eventos do site (filtros, busca...). Só envia se as estatísticas estiverem ligadas. */
window.klEvento=function(nome,dados){
if(!ligado){ return; }
dados=dados||{};
try{
if(window.gtag){ window.gtag("event",nome,dados); }
if(window.clarity){
window.clarity("event",nome);
if(dados.valor){ window.clarity("set",nome,String(dados.valor)); }
if(dados.termo){ window.clarity("set",nome,String(dados.termo)); }
}
}catch(e){}
};

function carregar(){
if(ligado){ return; }
ligado=true;

/* Google Analytics 4 */
window.dataLayer=window.dataLayer||[];
window.gtag=function(){ window.dataLayer.push(arguments); };
window.gtag("js",new Date());
window.gtag("config",GA_ID);
var ga=document.createElement("script");
ga.async=true;
ga.src="https://www.googletagmanager.com/gtag/js?id="+GA_ID;
document.head.appendChild(ga);

/* Microsoft Clarity */
(function(c,l,a,r,i,t,y){
c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window,document,"clarity","script",CLARITY_ID);
window.clarity("consent");
}

function apagarCookies(){
document.cookie.split(";").forEach(function(item){
var nome=item.split("=")[0].trim();
if(/^(_ga|_gid|_gat|_clck|_clsk|CLID|MUID)/.test(nome)){
var dominios=["",location.hostname,"."+location.hostname];
dominios.forEach(function(d){
document.cookie=nome+"=; Max-Age=0; path=/"+(d?"; domain="+d:"");
});
}
});
}

function ajustarChat(){
var altura=(aviso&&!aviso.hidden)?aviso.offsetHeight+16:0;
document.documentElement.style.setProperty("--kl-aviso",altura+"px");
}
function mostrar(){ if(aviso){ aviso.hidden=false; } ajustarChat(); }
function esconder(){ if(aviso){ aviso.hidden=true; } ajustarChat(); }
window.addEventListener("resize",ajustarChat);

/* Página de privacidade: botão "Alterar minha escolha". */
window.klCookies=mostrar;

if(aviso){
aviso.addEventListener("click",function(evento){
var botao=evento.target.closest("[data-cookies]");
if(!botao){ return; }
var escolha=botao.getAttribute("data-cookies");
var antes=ler();
salvar(escolha);
esconder();
if(escolha==="aceito"){
carregar();
}else if(antes==="aceito"){
/* Desligou: apaga os cookies e recarrega para parar os scripts. */
apagarCookies();
location.reload();
}
});
}

var escolha=ler();
if(escolha==="aceito"){
carregar();
}else if(escolha!=="recusado"){
mostrar();
}

})();
</script>

