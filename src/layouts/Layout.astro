<!-- Dica animada reutilizável: anel pulsando + mão tocando + balão.
     Uso: window.klDica(elemento, { nome, frase: "texto com {nome}", duracao, aoFechar }) -->
<script is:inline>
window.klDica=function(alvo,opcoes){

opcoes=opcoes||{};

var fechada=false;
var timer=null;

function escapar(texto){
return String(texto).replace(/[&<>"]/g,function(c){
return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c];
});
}

function montarFrase(nome){
return String(opcoes.frase||"").replace(
"{nome}",
"<b>“"+escapar(nome||"")+"”</b>"
);
}

var caixa=document.createElement("div");
caixa.className="kl-dica";
caixa.innerHTML=
'<div class="kl-dica-anel"></div>'+
'<div class="kl-dica-mao" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 11.24V7.5C9 6.12 10.12 5 11.5 5S14 6.12 14 7.5v3.74c1.21-.81 2-2.18 2-3.74C16 5.01 13.99 3 11.5 3S7 5.01 7 7.5c0 1.56.79 2.93 2 3.74zm9.84 4.63l-4.54-2.26c-.17-.07-.35-.11-.54-.11H13v-6c0-.83-.67-1.5-1.5-1.5S10 6.67 10 7.5v10.74l-3.43-.72c-.08-.01-.15-.03-.24-.03-.31 0-.59.13-.79.33l-.79.8 4.94 4.94c.27.27.65.44 1.06.44h6.79c.75 0 1.33-.55 1.44-1.28l.75-5.27c.01-.07.02-.14.02-.2 0-.62-.38-1.16-.91-1.38z"/></svg></div>'+
'<div class="kl-dica-balao" role="status"><strong>Dica</strong><span class="kl-dica-frase">'+montarFrase(opcoes.nome)+'</span>'+
'<button type="button">Entendi</button></div>';

function posicionar(){

var r=alvo.getBoundingClientRect();

/* Etiqueta fora da tela: esconde a dica até ela voltar (ou trocar de alvo). */
caixa.style.visibility=(r.bottom<0||r.top>innerHeight)?"hidden":"";

var anel=caixa.querySelector(".kl-dica-anel");
anel.style.left=(r.left-6)+"px";
anel.style.top=(r.top-6)+"px";
anel.style.width=(r.width+12)+"px";
anel.style.height=(r.height+12)+"px";

var mao=caixa.querySelector(".kl-dica-mao");
mao.style.left=(r.left+r.width/2-21)+"px";
mao.style.top=(r.top+r.height/2-12)+"px";

var balao=caixa.querySelector(".kl-dica-balao");
var largura=Math.min(280,innerWidth-24);
balao.style.width=largura+"px";

var esquerda=r.left+r.width/2-largura/2;
esquerda=Math.max(12,Math.min(esquerda,innerWidth-largura-12));

balao.style.left=esquerda+"px";
balao.style.top=(r.bottom+46)+"px";
balao.style.setProperty("--seta",(r.left+r.width/2-esquerda)+"px");

}

function aoClicar(evento){
if(evento.target.closest("[data-filtro-tipo], .etiqueta-link")){
fechar("clicou_etiqueta");
}
}

function fechar(acao){

if(fechada){ return; }

fechada=true;
clearTimeout(timer);

removeEventListener("scroll",posicionar);
removeEventListener("resize",posicionar);
document.removeEventListener("click",aoClicar,true);

if(typeof opcoes.aoFechar==="function"){
try{ opcoes.aoFechar(acao); }catch(e){}
}

caixa.classList.add("kl-dica-saindo");
setTimeout(function(){ caixa.remove(); },250);

}

document.body.appendChild(caixa);
caixa.querySelector("button").onclick=function(){ fechar("entendi"); };

posicionar();

addEventListener("scroll",posicionar,{passive:true});
addEventListener("resize",posicionar);
document.addEventListener("click",aoClicar,true);

timer=setTimeout(function(){ fechar("sumiu_sozinha"); },opcoes.duracao||10000);

return {
fechar:fechar,
alvo:function(){ return alvo; },
/* Aponta para outra etiqueta (ex.: a pessoa rolou a página). */
trocar:function(novoAlvo,novoNome){
alvo=novoAlvo;
caixa.querySelector(".kl-dica-frase").innerHTML=montarFrase(novoNome);
posicionar();
}
};

};
</script>

<style is:global>

/* Dica animada (mão apontando para uma etiqueta). */
.kl-dica{
  position:fixed;
  inset:0;
  z-index:1500;
  pointer-events:none;
  animation:kl-dica-entra .3s ease;
}

.kl-dica-saindo{
  opacity:0;
  transition:opacity .25s ease;
}

.kl-dica-anel{
  position:fixed;
  border-radius:10px;
  border:3px solid #ffc107;
  animation:kl-dica-pulso 1.4s ease-out infinite;
}

.kl-dica-mao{
  position:fixed;
  width:44px;
  height:44px;
  animation:kl-dica-toque 1.4s ease-in-out infinite;
  transform-origin:21px 12px;
}

.kl-dica-mao svg{
  width:100%;
  height:100%;
  fill:#fff;
  stroke:#111;
  stroke-width:.9;
  stroke-linejoin:round;
  filter:drop-shadow(2px 3px 2px rgba(0,0,0,.45));
}

.kl-dica-balao{
  --seta:50%;
  position:fixed;
  pointer-events:auto;
  padding:12px 14px;
  background:#1a1410;
  color:#f1ece4;
  border:2px solid #ffc107;
  border-radius:12px;
  box-shadow:0 10px 26px rgba(0,0,0,.35);
  font-size:.9rem;
  line-height:1.4;
}

.kl-dica-balao::before{
  content:"";
  position:absolute;
  top:-9px;
  left:calc(var(--seta) - 8px);
  width:14px;
  height:14px;
  background:#1a1410;
  border-left:2px solid #ffc107;
  border-top:2px solid #ffc107;
  transform:rotate(45deg);
}

.kl-dica-balao strong{
  display:block;
  margin-bottom:2px;
  color:#ffc107;
  font-size:.75rem;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.kl-dica-balao b{
  color:#ffc107;
}

.kl-dica-balao button{
  display:block;
  margin:10px 0 0 auto;
  padding:6px 14px;
  border:0;
  border-radius:8px;
  background:#ffc107;
  color:#111;
  font-weight:800;
  cursor:pointer;
}

@keyframes kl-dica-entra{
  from{ opacity:0; }
  to{ opacity:1; }
}

@keyframes kl-dica-pulso{
  0%{ box-shadow:0 0 0 0 rgba(255,193,7,.7); }
  100%{ box-shadow:0 0 0 14px rgba(255,193,7,0); }
}

/* A mão vem de baixo e "toca" a etiqueta. */
@keyframes kl-dica-toque{
  0%{ transform:translate(26px,34px); opacity:0; }
  25%{ transform:translate(0,0); opacity:1; }
  40%{ transform:translate(0,0) scale(.85); }
  55%{ transform:translate(0,0) scale(1); }
  85%{ transform:translate(0,0); opacity:1; }
  100%{ transform:translate(26px,34px); opacity:0; }
}

@media(prefers-reduced-motion:reduce){
  .kl-dica-mao,
  .kl-dica-anel{
    animation:none;
  }
}


/* Chat de recados (canto da tela). */
.kl-chat{
  position:fixed;
  right:20px;
  bottom:calc(20px + var(--kl-aviso, 0px));
  z-index:1900;
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:12px;
  font-family:system-ui,sans-serif;
  transition:bottom .2s ease;
}

.kl-chat-botao{
  display:flex;
  align-items:center;
  gap:8px;
  height:56px;
  padding:0 16px;
  border:3px solid #111;
  border-radius:999px;
  background:#ffc107;
  color:#111;
  font-weight:800;
  cursor:pointer;
  filter:drop-shadow(4px 4px 0 #b8860b);
  transition:transform .12s ease;
}

.kl-chat-botao:hover{
  transform:translateY(-2px);
}

.kl-chat-botao svg{
  width:26px;
  height:26px;
  fill:none;
  stroke:#111;
  stroke-width:2.2;
  stroke-linecap:round;
  stroke-linejoin:round;
}

/* Minimizado no celular: só o ícone. */
@media(max-width:576px){
  .kl-chat{ right:14px; }
  .kl-chat-botao{ width:56px; padding:0; justify-content:center; }
  .kl-chat-rotulo{ display:none; }
}

.kl-chat-painel{
  width:min(340px, calc(100vw - 28px));
  max-height:calc(100vh - 120px - var(--kl-aviso, 0px));
  overflow:auto;
  background:#1a1410;
  color:#f1ece4;
  border:2px solid #ffc107;
  border-radius:16px;
  box-shadow:0 18px 40px rgba(0,0,0,.4);
}

.kl-chat-painel[hidden]{
  display:none;
}

.kl-chat-painel.piscar{
  animation:kl-chat-piscar .45s ease-in-out 4;
}

@keyframes kl-chat-piscar{
  0%,100%{ box-shadow:0 18px 40px rgba(0,0,0,.4); border-color:#ffc107; }
  50%{ box-shadow:0 0 0 6px rgba(255,193,7,.55),0 18px 40px rgba(0,0,0,.4); border-color:#fff3b0; }
}

.kl-chat-topo{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:10px;
  padding:14px 16px 10px;
  border-bottom:1px solid rgba(255,193,7,.25);
}

.kl-chat-topo strong{
  display:block;
  color:#ffc107;
  font-size:1.05rem;
}

.kl-chat-topo small{
  color:rgba(241,236,228,.75);
}

.kl-chat-fechar{
  border:0;
  background:none;
  color:#f1ece4;
  font-size:1.6rem;
  line-height:1;
  cursor:pointer;
}

.kl-chat-form,
.kl-chat-ok{
  padding:12px 16px 16px;
}

.kl-chat-form[hidden],
.kl-chat-ok[hidden]{
  display:none;
}

.kl-chat-tipos{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-bottom:10px;
}

.kl-chat-tipos input{
  position:absolute;
  opacity:0;
  pointer-events:none;
}

.kl-chat-tipos span{
  display:inline-block;
  padding:5px 10px;
  border:1.5px solid rgba(241,236,228,.4);
  border-radius:999px;
  font-size:.8rem;
  cursor:pointer;
}

.kl-chat-tipos input:checked + span{
  background:#ffc107;
  border-color:#ffc107;
  color:#111;
  font-weight:700;
}

.kl-chat-tipos input:focus-visible + span{
  outline:2px solid #fff;
}

.kl-chat-campo{
  display:block;
  margin-bottom:10px;
  font-size:.85rem;
  font-weight:700;
}

.kl-chat-campo small{
  font-weight:400;
  color:rgba(241,236,228,.7);
}

.kl-chat-campo textarea,
.kl-chat-campo input{
  display:block;
  width:100%;
  margin-top:4px;
  padding:9px 10px;
  border:2px solid #3a312a;
  border-radius:10px;
  background:#0f0c0a;
  color:#fff;
  font:inherit;
  font-weight:400;
  resize:vertical;
}

.kl-chat-campo textarea:focus,
.kl-chat-campo input:focus{
  outline:none;
  border-color:#ffc107;
}

.kl-chat-armadilha{
  position:absolute;
  left:-9999px;
  width:1px;
  height:1px;
  opacity:0;
}

.kl-chat-erro{
  display:block;
  margin:-4px 0 10px;
  color:#ff8a7a;
  font-size:.82rem;
}

.kl-chat-enviar,
.kl-chat-outra{
  width:100%;
  padding:10px;
  border:2px solid #111;
  border-radius:10px;
  background:#ffc107;
  color:#111;
  font-weight:800;
  cursor:pointer;
}

.kl-chat-enviar:disabled{
  opacity:.65;
  cursor:wait;
}

.kl-chat-aviso{
  margin:8px 0 0;
  font-size:.72rem;
  color:rgba(241,236,228,.6);
}

.kl-chat-aviso a{
  color:rgba(241,236,228,.85);
}

.kl-chat-ok strong{
  display:block;
  margin-bottom:6px;
  color:#ffc107;
  font-size:1.05rem;
}

.kl-chat-ok p{
  font-size:.9rem;
}

@media(prefers-reduced-motion:reduce){
  .kl-chat-painel.piscar{ animation:none; }
}


/* Sol e lua na barra de cima. */
.kl-tema{
  display:flex;
  gap:2px;
  padding:3px;
  border:1px solid rgba(255,255,255,.25);
  border-radius:999px;
}

.kl-tema-btn{
  display:flex;
  align-items:center;
  justify-content:center;
  width:30px;
  height:30px;
  padding:0;
  border:0;
  border-radius:50%;
  background:transparent;
  cursor:pointer;
  opacity:.55;
  transition:background .15s ease,opacity .15s ease;
}

.kl-tema-btn svg{
  width:18px;
  height:18px;
  fill:none;
  stroke:#fff;
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.kl-tema-btn[data-tema="escuro"] svg{
  fill:#fff;
  stroke:none;
}

.kl-tema-btn:hover{
  opacity:.85;
}

[data-bs-theme="light"] .kl-tema-btn[data-tema="claro"],
[data-bs-theme="dark"] .kl-tema-btn[data-tema="escuro"]{
  background:rgba(255,255,255,.18);
  opacity:1;
}

/* ===== Tema escuro (lua): fundo preto no resto do site ===== */
[data-bs-theme="dark"]{
  --bs-body-bg:#0e0b09;
  --bs-body-color:#ece6dc;
  --bs-secondary-color:rgba(236,230,220,.68);
  --bs-tertiary-bg:#1a1512;
  --bs-border-color:#3a312a;
}

[data-bs-theme="dark"] .card{
  --bs-card-bg:#1a1512;
  --bs-card-border-color:#2c2520;
}

[data-bs-theme="dark"] .text-muted{
  color:var(--bs-secondary-color) !important;
}

[data-bs-theme="dark"] .btn-outline-dark{
  --bs-btn-color:#ece6dc;
  --bs-btn-border-color:#5a4f46;
  --bs-btn-hover-bg:#ece6dc;
  --bs-btn-hover-color:#111;
  --bs-btn-hover-border-color:#ece6dc;
  --bs-btn-active-bg:#ece6dc;
  --bs-btn-active-color:#111;
  --bs-btn-active-border-color:#ece6dc;
}

[data-bs-theme="dark"] .filtro-ativo,
[data-bs-theme="dark"] .filtro-ativo:hover{
  background:#ffc107 !important;
  border-color:#ffc107 !important;
  color:#111 !important;
}

/* Os estilos das páginas são mais específicos: por isso o !important. */
[data-bs-theme="dark"] .titulo-filtro{
  color:#ece6dc !important;
}

[data-bs-theme="dark"] .busca-filtro input{
  background:#1a1512 !important;
  color:#ece6dc !important;
  border-color:#5a4f46 !important;
}

[data-bs-theme="dark"] .busca-filtro input::placeholder{
  color:rgba(236,230,220,.5) !important;
}

[data-bs-theme="dark"] .busca-filtro button{
  background:#2c2520 !important;
  color:#ece6dc !important;
}

[data-bs-theme="dark"] .busca-sem-resultado,
[data-bs-theme="dark"] .destaques-topo p{
  color:var(--bs-secondary-color) !important;
}

[data-bs-theme="dark"] .sidebar{
  background:var(--bs-body-bg) !important;
}

[data-bs-theme="dark"] .thumb-btn{
  background:#1a1512 !important;
}

[data-bs-theme="dark"] .thumb-btn.thumb-ativa{
  border-color:#ffc107 !important;
}

/* Etiquetas escuras (classe) ganham um contorno para não sumir no fundo preto. */
[data-bs-theme="dark"] .badge.text-bg-dark,
[data-bs-theme="dark"] .badge-classe{
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.3);
}

</style>

</body>
</html>
